<Window x:Class="ChatGPTMultiView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT MultiView"
        Width="1600"
        Height="1000">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="8">
            <Button Content="1画面" Tag="1" Click="PaneCountButton_Click" Margin="0,0,6,0" Padding="12,6" />
            <Button Content="2画面" Tag="2" Click="PaneCountButton_Click" Margin="0,0,6,0" Padding="12,6" />
            <Button Content="3画面" Tag="3" Click="PaneCountButton_Click" Margin="0,0,6,0" Padding="12,6" />
            <Button Content="4画面" Tag="4" Click="PaneCountButton_Click" Padding="12,6" />
        </StackPanel>

        <Grid x:Name="PaneGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PaneContainer1" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Title1" Text="ChatGPT 1" Padding="8,5" />
                <wv2:WebView2 x:Name="Pane1" Grid.Row="1" Margin="0,2,0,0" />
            </Grid>

            <Grid x:Name="PaneContainer2" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Title2" Text="ChatGPT 2" Padding="8,5" />
                <wv2:WebView2 x:Name="Pane2" Grid.Row="1" Margin="0,2,0,0" />
            </Grid>

            <Grid x:Name="PaneContainer3" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Title3" Text="ChatGPT 3" Padding="8,5" />
                <wv2:WebView2 x:Name="Pane3" Grid.Row="1" Margin="0,2,0,0" />
            </Grid>

            <Grid x:Name="PaneContainer4" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Title4" Text="ChatGPT 4" Padding="8,5" />
                <wv2:WebView2 x:Name="Pane4" Grid.Row="1" Margin="0,2,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
